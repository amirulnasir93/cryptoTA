# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite for local dev. Swap to a postgresql:// URL later with zero query changes.
# NOTE: Prisma resolves a relative file: path against prisma/schema.prisma's own
# directory (packages/backend/prisma/), not the package root -- so this ends up
# at packages/backend/prisma/dev.db, not packages/backend/dev.db.
DATABASE_URL="file:./dev.db"

# Port the Fastify API listens on.
PORT=3001

# Origin the web frontend runs on, for CORS. Vite's default dev port.
WEB_ORIGIN="http://localhost:5173"

# Shared-secret header required to call POST /refresh/run and POST /sync/sheets/run
# from outside the process (e.g. a GitHub Actions cron job once this is hosted).
# Generate any long random string.
REFRESH_SECRET="change-me"

# Optional: raises CoinGecko's free-tier rate limit if set.
COINGECKO_API_KEY=

# Google Sheets two-way sync (Phase 7 / Phase 0 prerequisite). See docs/SHEETS_SETUP.md.
GOOGLE_SERVICE_ACCOUNT_FILE="./secrets/service-account.json"
GOOGLE_SHEET_ID=

# How often the background jobs run, in cron syntax.
REFRESH_CRON="*/5 * * * *"
SHEET_SYNC_CRON="*/5 * * * *"
CATALYST_SYNC_CRON="0 */6 * * *"

# Auto-imported catalysts (unlocks/listings/etc) from CoinMarketCal. Optional --
# sign up yourself at https://coinmarketcal.com/en/api (Claude Code can't create
# accounts on your behalf) and paste the key here. See docs/CATALYSTS_SETUP.md.
COINMARKETCAL_API_KEY=
